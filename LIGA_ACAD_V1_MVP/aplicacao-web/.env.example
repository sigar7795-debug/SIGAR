# Backend-only PostgreSQL connection (use the Supabase pooler on Vercel).
# TLS is enabled by the server configuration.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres

# Supabase Auth public configuration. Keep both server-side in Vercel for this app.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Generate a long random value for signing the SIGAR HTTP-only session cookie.
JWT_SECRET=GENERATE_A_RANDOM_SECRET
